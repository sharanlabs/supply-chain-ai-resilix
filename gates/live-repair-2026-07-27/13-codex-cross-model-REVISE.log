   101	// Core decision. Pure aside from the module Map; `now` is injected for tests.
   102	export function checkRateLimit(
   103	  bucketKey: string,
   104	  { limit, windowMs }: { limit: number; windowMs: number } = MUTATION_RATE_LIMIT,
   105	  now: number = Date.now()
   106	): RateLimitDecision {
   107	  const existing = buckets.get(bucketKey);
   108	
   109	  // New key, or the previous window has fully elapsed -> start a fresh window.
   110	  // This is the "window resets" behavior: once now >= windowStart + windowMs the
   111	  // count is discarded, not decayed.
   112	  if (!existing || now - existing.windowStartMs >= windowMs) {
   113	    // A brand-new key grows the Map; enforce the hard cap first so a key-rotating flood
   114	    // cannot grow it without bound. Updating an EXISTING active window (the else path below)
   115	    // never adds a key, so it needs no cap check.
   116	    if (!existing) {
   117	      enforceKeyCap(now, windowMs);
   118	    }
   119	    buckets.set(bucketKey, { count: 1, windowStartMs: now });
   120	    return { allowed: true, retryAfterSeconds: 0, remaining: limit - 1, limit };
   121	  }
   122	
   123	  if (existing.count >= limit) {
   124	    const elapsed = now - existing.windowStartMs;
   125	    // Round UP so Retry-After never tells the caller to retry before the window
   126	    // actually rolls over (a 0.4s remainder must surface as 1s, not 0s).
   127	    const retryAfterSeconds = Math.max(1, Math.ceil((windowMs - elapsed) / 1000));
   128	    return { allowed: false, retryAfterSeconds, remaining: 0, limit };
   129	  }
   130	
   131	  existing.count += 1;
   132	  return {
   133	    allowed: true,
   134	    retryAfterSeconds: 0,
   135	    remaining: limit - existing.count,
   136	    limit
   137	  };
   138	}
   139	
   140	// Derive a stable client identifier for the limiter key. Preference order:
   141	//   1. the bearer APPROVAL_TOKEN (an authorized caller is rate-limited per token)
   142	//   2. the first x-forwarded-for hop, else x-real-ip (the in-memory demo posture)
   143	//   3. a constant demo bucket (no proxy headers, no token) -- shared, by design,
   144	//      since the authless local demo has no per-caller signal to key on.
   145	// The bearer token is FINGERPRINTED (SHA-256 prefix) before it becomes a map key -- never
   146	// stored raw -- so the in-memory key set can't be turned back into the secret (e.g. by a heap
   147	// dump), while staying a stable, distinct per-token identity (Codex design grill, 2026-06-20).
   148	export function clientIdFromRequest(request: Request): string {
   149	  const auth = request.headers.get("authorization")?.trim() ?? "";
   150	  const bearer = /^Bearer\s+(.+)$/i.exec(auth);
   151	  if (bearer) {
   152	    const fingerprint = createHash("sha256").update(bearer[1].trim()).digest("hex").slice(0, 16);
   153	    return `tok:${fingerprint}`;
   154	  }
   155	
   156	  const forwarded = request.headers.get("x-forwarded-for")?.trim();
   157	  if (forwarded) {
   158	    // x-forwarded-for is a comma-separated list; the first hop is the client.
   159	    return `ip:${forwarded.split(",")[0].trim()}`;
   160	  }
   161	
   162	  const realIp = request.headers.get("x-real-ip")?.trim();
   163	  if (realIp) {
   164	    return `ip:${realIp}`;
   165	  }
   166	
   167	  return "demo:shared";
   168	}
   169	
   170	// Convenience used by the routes: build the per-route key and apply the limit.
   171	export function enforceMutationRateLimit(
   172	  routeKey: string,
   173	  request: Request,
   174	  now: number = Date.now()
   175	): RateLimitDecision {
   176	  const key = `${routeKey}:${clientIdFromRequest(request)}`;
   177	  return checkRateLimit(key, MUTATION_RATE_LIMIT, now);
   178	}
