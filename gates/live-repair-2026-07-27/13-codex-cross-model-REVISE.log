   132	        if (body.ok !== true) {
   133	          throw new SlackTransportError(safeErrorCode(body.error), "Slack chat.postMessage reported a logical failure");
   134	        }
   135	
   136	        // Trap part 3: a real Slack success ALWAYS carries ts (the message id). ok:true with no ts is
   137	        // malformed -- do NOT fabricate a ref and claim delivered (Codex Med): throw, fail-closed.
   138	        if (typeof body.ts !== "string" || body.ts.length === 0) {
   139	          throw new SlackTransportError("slack_malformed_success", "Slack chat.postMessage returned ok without a message ts");
   140	        }
   141	
   142	        // Success: ts is Slack's message id -> the audit providerRef. delivered:true.
   143	        logger.info(
   144	          {
   145	            event: "action.slack_dispatch",
   146	            actionType: message.actionType,
   147	            channel: message.channel,
   148	            idempotencyKey: message.idempotencyKey,
   149	            delivered: true
   150	          },
   151	          "slack-transport: message delivered"
   152	        );
   153	        return { transport: "slack", providerRef: body.ts, delivered: true };
   154	      } finally {
   155	        clearTimeout(timer);
   156	      }
   157	    }
   158	  };
   159	}
