    91	// Invariant: called before every new-key insert, so size <= MAX_TRACKED_KEYS always holds and
    92	// the while-loop below runs at most once per insert (it is a loop only as a safety backstop).
    93	function enforceKeyCap(now: number, windowMs: number): void {
    94	  if (buckets.size < MAX_TRACKED_KEYS) return;
    95	  pruneExpired(now, windowMs);
    96	  while (buckets.size >= MAX_TRACKED_KEYS) {
