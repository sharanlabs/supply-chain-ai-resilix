    64	function pruneExpired(now: number, windowMs: number): void {
    65	  for (const [key, state] of buckets) {
    66	    if (now - state.windowStartMs >= windowMs) {
    67	      buckets.delete(key);
    68	    }
    69	  }
    70	}
    71	
    72	// Evict the single entry with the oldest window start, via ONE O(n) pass -- no clone, no sort.
    73	// Because enforceKeyCap runs before EVERY key insert, the Map can never exceed the cap, so at
    74	// most one eviction is ever needed per insert. A clone+sort here (an earlier draft) would have
    75	// turned every at-cap insert into an attacker-triggered O(n log n) allocation -- the Codex
    76	// cross-model pass caught that; a linear min-scan matches the cost profile the pre-existing
    77	// pruneExpired sweep already accepted (one O(n) pass per at-cap insert).
    78	function evictOldestWindow(): void {
    79	  let oldestKey: string | null = null;
    80	  let oldestStart = Infinity;
    81	  for (const [key, state] of buckets) {
    82	    if (state.windowStartMs < oldestStart) {
    83	      oldestStart = state.windowStartMs;
