   194	  const generate =
   195	    args.generate ??
   196	    (async (a: { model: string; schema: z.ZodTypeAny; prompt: string }) => {
   197	      const result = await generateObject({
   198	        model: geminiModel(a.model),
   199	        schema: a.schema,
   200	        prompt: a.prompt,
   201	        // Bound the output so the pre-call estimate is a TRUE ceiling (the $5 hard-stop checks
   202	        // the estimate BEFORE this call; without a cap the model could overshoot it).
   203	        maxOutputTokens: MAX_LIVE_OUTPUT_TOKENS,
   204	        // Disable the SDK's own transport retry loop (Codex P3 High): an SDK retry is NOT guarded
   205	        // by the pre-call budget check and its billed-but-failed attempts are not ledgered, so a
   206	        // hidden retry could bill past the cap. The app has its OWN bounded retry (RetryReserve),
   207	        // which re-checks the budget per attempt -- the only retry path we want billing through.
   208	        maxRetries: 0
