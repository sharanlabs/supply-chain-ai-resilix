   744	  const listPackets = deps?.listPackets ?? (async () => (await listDecisionPackets()) as DecisionPacket[]);
   745	  // Final-gate Codex MED: the boot sweep uses CONFIGURED transports so a recovered
   746	  // REVERSIBLE action reaches the transport an operator set (empty {} -> all-Noop for
   747	  // the keyless demo, unchanged). The moat is intact: reconcile re-drives only
   748	  // REVERSIBLE actions, never the outward ERP_CASE/n8n path.
   749	  const registry = deps?.registry ?? transportRegistryFromEnv();
   750	  const reconcile =
   751	    deps?.reconcile ?? ((input) => reconcileStrandedDispatches({ ...input, deps: { registry } }));
   752	  const summary = { packetsScanned: 0, reExecuted: 0, reFailed: 0, errored: 0 };
   753	
   754	  let packets: DecisionPacket[];
   755	  try {
   756	    packets = await listPackets();
   757	  } catch (e) {
   758	    logger.warn(
   759	      { event: "action.boot_reconcile_list_failed", error: e instanceof Error ? e.message : String(e) },
   760	      "action-executor: boot reconcile could not list packets; skipping sweep (non-fatal)"
   761	    );
   762	    return summary;
   763	  }
   764	
   765	  for (const packet of packets) {
   766	    summary.packetsScanned += 1;
   767	    try {
   768	      const res = await reconcile({ packet });
   769	      summary.reExecuted += res.reExecuted;
   770	      summary.reFailed += res.reFailed;
   771	    } catch (e) {
   772	      // One packet's failure never aborts the sweep or the boot.
   773	      summary.errored += 1;
   774	      logger.warn(
   775	        {
   776	          event: "action.boot_reconcile_packet_failed",
   777	          packetId: packet.id,
   778	          error: e instanceof Error ? e.message : String(e)
   779	        },
   780	        "action-executor: boot reconcile failed for one packet; continuing"
   781	      );
   782	    }
   783	  }
   784	
   785	  logger.info(
   786	    { event: "action.boot_reconcile_complete", ...summary },
   787	    "action-executor: startup stranded-dispatch reconcile sweep complete"
   788	  );
   789	  return summary;
   790	}
