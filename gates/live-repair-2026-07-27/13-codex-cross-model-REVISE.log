   211	        object: result.object,
   212	        usage: {
   213	          inputTokens: result.usage?.inputTokens,
   214	          outputTokens: result.usage?.outputTokens,
   215	          totalTokens: result.usage?.totalTokens,
   216	          finishReason: result.finishReason ?? null
   217	        } satisfies AgentRunUsage
   218	      };
   219	    });
