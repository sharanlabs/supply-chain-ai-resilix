     1	import type { AgentRun } from "@/lib/schemas";
     2	import { stableHash } from "@/lib/utils";
     3	import { PRICING_VERSION, costUsd } from "@/lib/agents/pricing";
     4	
     5	// A compact token estimate (chars / 4) -- a rough relative-size proxy kept for the UI
     6	// and existing readers. The D.8 cost ledger (inputTokens/outputTokens/costUsd, below)
     7	// carries the REAL provider-reported counts and the dollar cost; this heuristic is no
     8	// longer the cost signal, just a cheap size hint.
     9	function estimateTokens(value: unknown): number {
    10	  return Math.ceil(JSON.stringify(value).length / 4);
    11	}
    12	
    13	// The API-reported usage a live call threads in. Every field is optional because the
    14	// AI SDK reports each usage number as `number | undefined` -- a successful call may
    15	// still leave one absent. The deterministic path passes no usage at all (0 tokens).
    16	export type AgentRunUsage = {
    17	  inputTokens?: number;
    18	  outputTokens?: number;
    19	  totalTokens?: number;
    20	  finishReason?: string | null;
    21	};
    22	
    23	// Build the audit record for one agent step. D.1 agents are all deterministic, so
    24	// model defaults to "deterministic-rules", mode DETERMINISTIC_RULES, latency 0.
    25	// The LLM agents (D.5-D.7) pass mode "LIVE_AI" plus the resolved model id -- which
    26	// is single-sourced from the model config built in D.5, never hard-coded here.
    27	//
    28	// D.8 cost ledger: every run is stamped with a cost. The DETERMINISTIC path (no
    29	// `usage` passed) costs $0 and is marked finishReason "deterministic" -- it stamps
    30	// costUsd: 0 DIRECTLY and NEVER calls costUsd("deterministic-rules", ...), so the
    31	// pricing table's fail-loud-on-unknown-model guard stays a REAL guard (it fires only
    32	// on a typo'd/retired LIVE id, not on every deterministic run). The LIVE path passes
    33	// `usage`, and costUsd(model, in, out) computes the real dollar cost from the pinned
    34	// price list. errorClass marks a degraded attempt (null on a healthy run). pricingVersion
    35	// is stamped on every run so a re-price is an explicit migration, never silent.
    36	export function makeAgentRun(args: {
    37	  id: string;
    38	  agentName: string;
    39	  input: unknown;
    40	  output: unknown;
    41	  summary: string;
    42	  createdAt: string;
    43	  model?: string;
    44	  mode?: AgentRun["mode"];
    45	  latencyMs?: number;
    46	  validationStatus?: AgentRun["validationStatus"];
    47	  usage?: AgentRunUsage;
    48	  errorClass?: string | null;
    49	}): AgentRun {
    50	  const {
    51	    id,
    52	    agentName,
    53	    input,
    54	    output,
    55	    summary,
    56	    createdAt,
    57	    model = "deterministic-rules",
    58	    mode = "DETERMINISTIC_RULES",
    59	    latencyMs = 0,
    60	    validationStatus = "PASS",
    61	    usage,
    62	    errorClass = null
    63	  } = args;
    64	
    65	  // Cost: the deterministic path (no usage) is $0 with finishReason "deterministic"
    66	  // -- stamped directly, the table is NOT consulted. A live path passes usage, so the
    67	  // real ids + reported tokens flow through costUsd (which fails loud on an unknown
    68	  // live model). A live call that reports no usage prices at $0 (0 coerced tokens) but
    69	  // still records its model + pricingVersion, so the run is auditable, not invisible.
    70	  const isLive = usage !== undefined;
    71	  const inputTokens = usage?.inputTokens ?? 0;
    72	  const outputTokens = usage?.outputTokens ?? 0;
    73	  const totalTokens = usage?.totalTokens ?? inputTokens + outputTokens;
    74	  const finishReason = isLive ? (usage?.finishReason ?? null) : "deterministic";
    75	  const computedCostUsd = isLive ? costUsd(model, inputTokens, outputTokens) : 0;
    76	
    77	  return {
    78	    id,
    79	    agentName,
    80	    model,
    81	    mode,
    82	    latencyMs,
    83	    tokenEstimate: estimateTokens(input) + estimateTokens(output),
    84	    inputHash: stableHash(input),
    85	    outputHash: stableHash(output),
    86	    validationStatus,
    87	    summary,
    88	    createdAt,
    89	    inputTokens,
    90	    outputTokens,
    91	    totalTokens,
    92	    finishReason,
    93	    errorClass,
    94	    pricingVersion: PRICING_VERSION,
    95	    costUsd: computedCostUsd
    96	  };
    97	}

