    70	function digestToText(message: TransportMessage): string {
    71	  const lines = Object.entries(message.digest).map(
    72	    ([key, value]) => `• ${sanitizeText(key, MAX_FIELD_LEN)}: ${sanitizeText(String(value), MAX_FIELD_LEN)}`
    73	  );
    74	  return [`:rotating_light: RESILIX ${message.actionType} (${message.channel})`, ...lines].join("\n");
    75	}
