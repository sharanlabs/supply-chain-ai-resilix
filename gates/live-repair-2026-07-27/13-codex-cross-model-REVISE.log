   162	// liveGenerateObject: the SINGLE live-call boundary for the ActionOps LLM agents.
   163	// Two jobs, in order:
   164	//   1. BUDGET HARD-STOP (fail-closed): assertWithinBudget(spent, estimatedNext, cap)
   165	//      runs BEFORE generateObject, so a would-breach call THROWS and never bills.
   166	//      Key-OFF this code is never reached (the agent short-circuits earlier), so the
   167	//      no-network contract holds; key-ON under cap it proceeds.
   168	//   2. Call generateObject and return the object PLUS the reported usage, so the agent
   169	//      can thread real token counts into makeAgentRun for costUsd. generateObject's
   170	//      usage fields are `number | undefined`; they pass straight through (pricing
   171	//      coerces). model + schema are injected so the call is provider-bound in ONE place.
   172	// Injected `generate` (the raw SDK call) keeps this unit-reachable without network.
   173	export async function liveGenerateObject(args: {
   174	  model: string;
   175	  schema: z.ZodTypeAny;
   176	  prompt: string;
   177	  budget: BudgetContext;
   178	  generate?: (a: {
   179	    model: string;
   180	    schema: z.ZodTypeAny;
   181	    prompt: string;
   182	  }) => Promise<{ object: unknown; usage?: AgentRunUsage }>;
   183	}): Promise<LiveGenerateResult> {
