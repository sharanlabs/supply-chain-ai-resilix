   149	        // stably; an abort DURING the body read is a timeout, not a parse error.
   150	        let body: { id?: string };
   151	        try {
   152	          body = (await response.json()) as { id?: string };
   153	        } catch {
   154	          if (controller.signal.aborted) {
   155	            throw new EmailTransportError("email_timeout", "Resend send body read timed out");
   156	          }
   157	          throw new EmailTransportError("email_invalid_json", "Resend send returned unparseable JSON");
   158	        }
   159	
   160	        // Trap part 2: a real Resend success ALWAYS carries id. 200 with no id is malformed --
   161	        // do NOT fabricate a ref and claim delivered: throw, fail-closed.
   162	        if (typeof body.id !== "string" || body.id.length === 0) {
   163	          throw new EmailTransportError("email_malformed_success", "Resend send returned ok without an id");
   164	        }
