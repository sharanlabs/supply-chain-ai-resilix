   117	  enabled?: () => boolean;
   118	  generate?: (a: {
   119	    model: string;
   120	    schema: z.ZodTypeAny;
   121	    prompt: string;
   122	  }) => Promise<{ object: unknown; usage?: AgentRunUsage }>;
   123	}): Promise<JudgeVerdict> {
   124	  // BILLING SELF-GUARD (defense-in-depth): the judge calls liveGenerateObject, which BILLS. It
   125	  // must not fire on a real (non-injected) path when live AI is disabled, even if a caller forgets
   126	  // to gate it -- the billing-boundary first principle holds by construction, not by caller
   127	  // discipline. `enabled` defaults to liveAiEnabled (flag + key); an injected `generate` is a
   128	  // test/DI path that never bills, so it is allowed through. Key-OFF + no injected generate ->
   129	  // fail-closed (a flag), no call.
   130	  const enabled = args.enabled ?? judgeEnabled;
   131	  if (!enabled() && !args.generate) {
   132	    return {
   133	      supported: false,
   134	      reason: "Judge skipped: no judge provider configured (no Groq/Gemini key); failing closed.",
   135	      errored: true,
   136	      errorClass: "LIVE_AI_DISABLED"
   137	    };
   138	  }
   139	
   140	  const model = resolvedJudgeModel();
   141	  // Pick the provider call path. An injected generate (test/DI) ALWAYS wins. Otherwise the
   142	  // cross-family judge binds Groq here; the gemini path leaves generate undefined so
   143	  // liveGenerateObject falls back to its default Gemini generate.
   144	  let generate = args.generate;
   145	  if (!generate && resolvedJudgeProvider() === "groq") {
   146	    const key = groqApiKey();
   147	    if (key) {
   148	      generate = makeGroqGenerate(key, JUDGE_MAX_OUTPUT_TOKENS);
   149	    }
   150	  }
   151	  const budget: BudgetContext = args.budget ?? {
   152	    spentUsd: 0,
   153	    estimatedNextUsd: estimateLiveCallCostUsd(model)
   154	  };
   155	
   156	  const prompt =
   157	    "You are a claims auditor for supplier-facing crisis communications. You are given DRAFT " +
   158	    "PROSE and the SOURCE DATA the drafter was allowed to use. First REASON briefly about each " +
   159	    "factual assertion in the prose, then decide whether the prose makes any UNSUPPORTED assertion " +
   160	    "of fact about the world.\n\n" +
   161	    "SUPPORTED -- do NOT flag any of these:\n" +
   162	    "- The disruption premise: that an event exists and the recipient is a flagged exposed " +
   163	    "supplier on an affected lane (the source data establishes this).\n" +
   164	    "- Grounded values present in the source data (e.g. the exposure score, the assessment window).\n" +
   165	    "- The SENDER'S OWN forward intent or process: 'we are reviewing', 'we will confirm / share " +
   166	    "next steps / a contingency plan after review', 'no action is required from you yet', 'we " +
   167	    "request your lead times / input'. These state the sender's plan, not a fact about the world.\n\n" +
   168	    "UNSUPPORTED -- FLAG (supported=false) -- a factual assertion that EXCEEDS the source data:\n" +
   169	    "- a quantity not in the data ('$2 million', '20%', '5 days', '40% of volume', 'reopens in 12 days');\n" +
   170	    "- an action ALREADY TAKEN ('we have secured three suppliers', 'we rebooked your cargo', 'we " +
   171	    "approved a purchase order');\n" +
   172	    "- a definite external status ('your shipment is delayed', 'this is resolved', 'your premium increased');\n" +
   173	    "- a cause ('you are the sole cause') or a prediction ('prices will rise', 'this will last six weeks').\n\n" +
   174	    "WORKED EXAMPLES (critique, then verdict -- illustrative, NOT the data below):\n" +
   175	    "1. PROSE: 'We are reviewing contingency options and will confirm next steps after review.'\n" +
   176	    "   Critique: states only the sender's own forward intent; asserts no external fact. " +
   177	    "Verdict: supported=true.\n" +
   178	    "2. PROSE: 'We have already secured three alternate suppliers to cover any shortfall.'\n" +
   179	    "   Critique: asserts a completed action (suppliers secured) the source data does not contain. " +
   180	    "Verdict: supported=false; reason: 'claims three alternate suppliers already secured -- not in source data'.\n" +
   181	    "3. PROSE: 'Prices on this lane will rise 20% next month.'\n" +
   182	    "   Critique: a prediction plus a quantity (20%) absent from the data. " +
   183	    "Verdict: supported=false; reason: 'predicts a 20% price rise absent from source data'.\n\n" +
   184	    "Now judge the prose below. Put your brief critique THEN your conclusion in `reason`, and set " +
   185	    "`supported`=true ONLY if the prose makes NO unsupported assertion; otherwise false with a reason " +
   186	    "naming the FIRST unsupported assertion. Judge ONLY support-by-data, not tone or style.\n\n" +
   187	    `SOURCE DATA:\n${JSON.stringify(args.sourceData, null, 2)}\n\nDRAFT PROSE:\n${args.prose}`;
   188	
   189	  try {
   190	    const { object } = await liveGenerateObject({
   191	      model,
   192	      schema: JudgeVerdictSchema,
   193	      prompt,
   194	      budget,
   195	      generate
   196	    });
   197	    const parsed = JudgeVerdictSchema.safeParse(object);
   198	    if (!parsed.success) {
   199	      // Unparseable verdict -> fail closed (flag), never a silent pass.
   200	      return {
   201	        supported: false,
   202	        reason: "Judge returned an unparseable verdict; failing closed.",
   203	        errored: true,
   204	        errorClass: "UNPARSEABLE_VERDICT"
   205	      };
   206	    }
   207	    return { supported: parsed.data.supported, reason: parsed.data.reason, errored: false };
   208	  } catch (err) {
   209	    // Call threw (budget breach, network, refusal) -> fail closed.
   210	    return {
   211	      supported: false,
   212	      reason: err instanceof Error ? `Judge call failed: ${err.message}` : "Judge call failed.",
   213	      errored: true,
   214	      errorClass: "JUDGE_CALL_THREW"
   215	    };
   216	  }
   217	}
     1	// The COST LEDGER pricing table (D.8, R4-10). Pure + unit-testable. This is the
     2	// money side of the Success_Criteria "<=$5 total LLM spend" row: a real per-call
     3	// USD cost computed from API-reported token counts and a PINNED, VERSIONED price
     4	// table -- not the old chars/4 tokenEstimate, which never touched dollars.
     5	//
     6	// WHY a pinned table (not a live price fetch): prices move under the cutoff, so a
     7	// run's cost must be reproducible from the packet alone. The version string stamped
     8	// on every run/packet records WHICH price list produced the number, so a later
     9	// re-price is an explicit migration, never a silent retroactive change.
    10	//
    11	// Prices are per 1,000,000 tokens in USD, GA + live-verified on this project's key
    12	// (2026-06-18, two independent sources agree). Input = prompt tokens; output =
    13	// completion tokens. Source-of-truth for the model ids is resolvedGeminiModel()
    14	// in lib/agents/run.ts -- the SAME bare ids (no "models/" prefix) the AgentRun.model
    15	// field carries, so the table key and the run's model never drift.
    16	
    17	// The pinned price-list version. Bump this whenever the TABLE changes -- a provider re-prices OR a
    18	// provider is added -- so the stamp on each run records which list was in force. Bumped to 2026-07-22
    19	// when the Gemini 3.x GA rows were ADDED and the default moved to gemini-3.5-flash (Batch 7 recency
    20	// fix: Gemini 2.5 Flash is deprecation-scheduled 2026-10-16; the 2.5 rows stay so recorded runs and
    21	// fixtures keep pricing correctly). Pure string id.
    22	export const PRICING_VERSION = "2026-07-22";
    23	
    24	// Per-model USD price per 1,000,000 tokens. Keyed on the BARE Gemini id (matches
    25	// resolvedGeminiModel()). Live-verified against ai.google.dev/gemini-api/docs/pricing +
    26	// an independent tracker, 2026-07-22 (standard-context paid-tier rows; the tiered >200k
    27	// rates on -pro are deliberately NOT modeled -- our calls never approach 200k input).
    28	// gemini-3.5-flash is the GA default; the 2.5 line is deprecation-scheduled 2026-10-16
    29	// but still serving, kept for recorded-run reproducibility; gemini-3.6-flash (released
    30	// 2026-07-21) is priced but NOT the default until it has more than a day of history.
    31	type ModelPrice = { inputPerMillionUsd: number; outputPerMillionUsd: number };
    32	
    33	export const GEMINI_PRICING: Record<string, ModelPrice> = {
    34	  "gemini-3.6-flash": { inputPerMillionUsd: 1.5, outputPerMillionUsd: 7.5 },
    35	  "gemini-3.5-flash": { inputPerMillionUsd: 1.5, outputPerMillionUsd: 9 },
    36	  "gemini-3.5-flash-lite": { inputPerMillionUsd: 0.3, outputPerMillionUsd: 2.5 },
    37	  "gemini-3.1-flash-lite": { inputPerMillionUsd: 0.25, outputPerMillionUsd: 1.5 },
    38	  "gemini-2.5-flash": { inputPerMillionUsd: 0.3, outputPerMillionUsd: 2.5 },
    39	  "gemini-2.5-flash-lite": { inputPerMillionUsd: 0.1, outputPerMillionUsd: 0.4 },
    40	  "gemini-2.5-pro": { inputPerMillionUsd: 1.25, outputPerMillionUsd: 10 }
    41	};
    42	
    43	// Groq pricing (the cross-family LLM-as-judge provider; JUDGE_PROVIDER=groq). Priced at Groq's
    44	// PUBLISHED per-1M-token rates (groq.com/pricing, live-verified 2026-06-22), NOT at $0 -- on purpose.
    45	// Groq's free tier bills $0 in PRACTICE, but the code cannot prove a given key is free-tier (Groq has
    46	// paid/Developer tiers at these same model ids). Pricing a real call at $0 is the exact silent-$0
    47	// blind spot the guard below exists to prevent. The published rate is HONEST on a paid key and a
    48	// CONSERVATIVE over-estimate on the free tier -- which is how estimateLiveCallCostUsd is meant to err
    49	// (toward blocking, never toward overspend). EXPLICIT entries so an unlisted Groq id still throws.
    50	// Only the structured-output-capable judge models are listed (validated against Groq /models +
    51	// structured-outputs support). Re-verify these and bump PRICING_VERSION when Groq re-prices.
    52	export const GROQ_PRICING: Record<string, ModelPrice> = {
    53	  "meta-llama/llama-4-scout-17b-16e-instruct": { inputPerMillionUsd: 0.11, outputPerMillionUsd: 0.34 },
    54	  "openai/gpt-oss-120b": { inputPerMillionUsd: 0.15, outputPerMillionUsd: 0.6 },
    55	  "openai/gpt-oss-20b": { inputPerMillionUsd: 0.075, outputPerMillionUsd: 0.3 }
    56	};
    57	
    58	// Google's ListModels returns "models/gemini-2.5-flash" while our config + the
    59	// AgentRun.model field carry the bare id; strip the prefix so a prefixed id (should
    60	// one ever reach here) still keys the table instead of falsely failing as unknown.
    61	// Mirrors bareModelId() in run.ts -- one normalization notion, no divergence.
    62	function bareModelId(model: string): string {
    63	  return model.replace(/^models\//, "").trim();
    64	}
    65	
    66	// costUsd: the cost formula. Pure. cost = input/1e6 * inPrice + output/1e6 * outPrice.
    67	//
    68	// FAILS LOUD on an unknown model (throws) rather than silently pricing at $0 -- a
    69	// $0 cost on a real billed call is the exact blind spot that lets spend escape the
    70	// budget cap unseen. WHY this never fires on the deterministic path: the deterministic
    71	// path stamps costUsd: 0 DIRECTLY (it never calls costUsd with "deterministic-rules"),
    72	// so the only ids reaching here are real resolved Gemini ids -- a typo'd or retired
    73	// live id then fails loud, which is the intended guard.
    74	//
    75	// Token counts are coerced to a non-negative finite number: the AI SDK reports
    76	// usage fields as `number | undefined`, so a successful call can still hand us
    77	// undefined token counts. An undefined/NaN count prices at 0 tokens (cost from that
    78	// component is 0), but an unknown MODEL still throws -- the loud guard is on the
    79	// model id, not on the token count.
    80	export function costUsd(
    81	  model: string,
    82	  inputTokens: number | undefined,
    83	  outputTokens: number | undefined
    84	): number {
    85	  const key = bareModelId(model);
    86	  const price = GEMINI_PRICING[key] ?? GROQ_PRICING[key];
    87	  if (!price) {
    88	    throw new Error(
    89	      `costUsd: unknown model "${key}" -- not in the pinned pricing table ` +
    90	        `(${PRICING_VERSION}). Known models: ${[
    91	          ...Object.keys(GEMINI_PRICING),
    92	          ...Object.keys(GROQ_PRICING)
    93	        ].join(", ")}. Add it to the pricing table before billing a live call on it.`
    94	    );
    95	  }
    96	  const inTok = coerceTokens(inputTokens);
    97	  const outTok = coerceTokens(outputTokens);
    98	  return (
    99	    (inTok / 1_000_000) * price.inputPerMillionUsd +
   100	    (outTok / 1_000_000) * price.outputPerMillionUsd
   101	  );
   102	}
   103	
   104	// Coerce an API-reported token count to a non-negative finite number. undefined /
   105	// NaN / negative -> 0 (no cost contribution), so a missing usage field never throws
   106	// and never produces a NaN cost. The loud-failure guard lives on the model id.
   107	function coerceTokens(n: number | undefined): number {
   108	  return typeof n === "number" && Number.isFinite(n) && n > 0 ? n : 0;
   109	}

