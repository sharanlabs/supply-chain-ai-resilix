   245	describe.skipIf(!LIVE)("Skeptic calibration: live cross-family pass (BILLS Groq free tier, gated)", () => {
   246	  it(
   247	    "clears the TPR/TNR bar over the labelled findings, counting critic-error as fail-closed",
   248	    async () => {
   249	      const model = resolvedSkepticModel();
   250	      let spentUsd = 0;
   251	      // Positive class = UNSOUND (the finding we want REJECTED). "flag" = the Skeptic does NOT
   252	      // accept. TPR = rejected / actually-unsound; TNR = accepted / actually-sound. A critic error
   253	      // counts as a flag (fail-closed), so it can only hurt TNR, never inflate TPR.
   254	      let tp = 0;
   255	      let fn = 0;
   256	      let tn = 0;
   257	      let fp = 0;
   258	      const misses: string[] = [];
   259	
   260	      for (const spec of LABELED) {
   261	        const { threatCard, checks, exposures } = inputsFor(spec);
   262	        const { verdict } = await challengeFindingLive(ctx(), threatCard, checks, exposures, {
   263	          budget: {
   264	            spentUsd,
   265	            estimatedNextUsd: estimateLiveCallCostUsd(model),
   266	            capUsd: DEFAULT_BUDGET_CAP_USD
   267	          }
   268	        });
   269	        spentUsd += estimateLiveCallCostUsd(model);
   270	        // Space the calls under the Groq free-tier TPM window. A throttled (429) call fails CLOSED
   271	        // to a HOLD, which this harness then scores as a false REJECT -- so an under-spaced run
   272	        // reports a bogus TNR collapse and slanders a healthy critic.
   273	        //
   274	        // RE-CALIBRATED 2026-07-27 (L-1): 4,000ms was sized for llama-4-scout's ~30K TPM allowance.
   275	        // The gpt-oss models cap at 8,000 TPM on this key, and Groq reserves
   276	        // `input + max_completion_tokens` per call (~1,421 + 1,200 = ~2,621 here), so the window
   277	        // sustains only ~3 calls/minute => ~20s between calls. At 4s the suite measured TNR 40%,
   278	        // then 80% with 6 and 2 misses respectively -- EVERY miss tagged "(error)", i.e. the
