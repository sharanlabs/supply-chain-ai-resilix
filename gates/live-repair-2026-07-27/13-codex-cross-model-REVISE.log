   315	    retrySpent += perCallEstimate;
   316	
   317	    const result = validate(object);
   318	    if (result.ok) {
   319	      return { ok: true, value: result.value, usage: agg };
   320	    }
   321	    // A retryable slip: re-ask only if the SHARED reserve still has an attempt; else fall back.
   322	    if (result.retryable && retry?.tryConsume()) {
   323	      continue;
   324	    }
   325	    return { ok: false, reason: result.reason, errorClass: result.errorClass, usage: agg };
   326	  }
   327	  // Unreachable in normal operation (the reserve goes empty first); a fail-safe so a mis-wired
   328	  // reserve degrades to fallback rather than looping.
   329	  return {
   330	    ok: false,
   331	    reason: "Live AI exceeded the retry reserve without a clean result.",
   332	    errorClass: "RETRY_EXHAUSTED",
   333	    usage: agg
   334	  };
   335	}
