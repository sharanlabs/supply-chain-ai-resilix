    48	// Sanitize an untrusted Slack error string into a stable, bounded errorClass code. Slack
    49	// codes are snake_case enums, but the value is provider-controlled and is PERSISTED+LOGGED
    50	// as errorClass, so we strip to [a-z0-9_], cap the length, and map anything empty/odd to
    51	// slack_unknown (Codex High #2: no unbounded/poisoned string into the audit ledger).
    52	function safeErrorCode(raw: unknown): string {
    53	  if (typeof raw !== "string") return "slack_unknown";
    54	  const cleaned = raw.toLowerCase().replace(/[^a-z0-9_]/g, "").slice(0, MAX_ERROR_CODE_LEN);
    55	  return cleaned.length > 0 ? `slack_${cleaned}` : "slack_unknown";
    56	}
