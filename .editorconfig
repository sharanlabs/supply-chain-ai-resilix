# https://editorconfig.org -- matches CI Node 24 + the codebase's 2-space style
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown trailing whitespace can be a meaningful line break -- leave it.
[*.md]
trim_trailing_whitespace = false
