    49	//     credentials/webhook/) -- there is no standard header like Slack/Resend's
    50	//     Authorization: Bearer. So the header name is itself configuration, not
    51	//     hardcoded. Auth is optional (many self-hosted n8n setups skip it); if
    52	//     configured, BOTH name and value are required together.
    53	//
    54	// The thrown error's NAME (not message) becomes the audited errorClass
    55	// (action-executor finalizes on error.name) and is LOGGED -- a sanitized,
    56	// length-capped code, never the header value, never body prose.
    57	// ---------------------------------------------------------------------------
    58	
    59	const DEFAULT_TIMEOUT_MS = 10_000;
    60	
    61	export class N8nTransportError extends Error {
    62	  constructor(errorClass: string, humanReason: string) {
    63	    super(humanReason);
    64	    this.name = errorClass;
    65	  }
    66	}
    67	
    68	export type N8nTransportConfig = {
