   210	      sourceCount: verifierChecks.sourceCount,
   211	      corroborated: verifierChecks.corroborated,
   212	      geo: verifierChecks.geo,
   213	      freshestMinutes: verifierChecks.freshestMinutes
   214	    },
   215	    exposure: {
   216	      count: exposureResults.length,
   217	      topSectors: topSectors.slice(0, 3),
   218	      singleSourceCount: exposureResults.filter((e) => e.singleSource === true).length
