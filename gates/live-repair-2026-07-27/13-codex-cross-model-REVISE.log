   277	    // Degenerate inputs must not throw or return NaN.
   278	    expect(cohensKappa({ tp: 0, fp: 0, tn: 0, fn: 0 })).toBe(0);
   279	    expect(Number.isNaN(cohensKappa({ tp: 5, fp: 0, tn: 0, fn: 0 }))).toBe(false);
   280	  });
