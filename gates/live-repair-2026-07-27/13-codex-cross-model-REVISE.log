   259	// Held-out split. DEV is reserved as the few-shot exemplar source (used when the billed
   260	// recalibration adds critique-then-verdict few-shot -- ADR-0002); TEST is the held-out set the
   261	// live metrics are reported over, so TPR/TNR/kappa are never measured on prose the judge prompt
   262	// was tuned on. Deterministic (first `devPerClass` of each class -> DEV, remainder -> TEST).
   263	function splitDevTest(set: LabeledProse[], devPerClass = 3) {
   264	  const supported = set.filter((x) => x.supported);
   265	  const unsupported = set.filter((x) => !x.supported);
   266	  const dev = [...supported.slice(0, devPerClass), ...unsupported.slice(0, devPerClass)];
   267	  const test = [...supported.slice(devPerClass), ...unsupported.slice(devPerClass)];
   268	  return { dev, test };
   269	}
