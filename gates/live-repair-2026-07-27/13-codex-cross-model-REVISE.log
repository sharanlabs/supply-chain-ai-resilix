   102	        let response: Response;
   103	        try {
   104	          response = await doFetch(RESEND_SEND_URL, {
   105	            method: "POST",
   106	            headers: {
   107	              // The key is sent ONLY in the Authorization header -- never logged, never in an error.
   108	              Authorization: `Bearer ${config.apiKey}`,
   109	              "Content-Type": "application/json; charset=utf-8",
   110	              // Resend-native dedup: a retry of the SAME logical action reuses the same key,
   111	              // so a stranded/retried dispatch cannot double-send (Resend dedupes for 24h).
   112	              "Idempotency-Key": message.idempotencyKey
   113	            },
   114	            body: JSON.stringify({
   115	              from: config.fromEmail,
   116	              to: config.toEmail,
   117	              subject: digestToSubject(message),
   118	              text: digestToText(message)
   119	            }),
   120	            signal: controller.signal
   121	          });
   122	        } catch {
   123	          if (controller.signal.aborted) {
   124	            throw new EmailTransportError("email_timeout", "Resend send timed out");
   125	          }
   126	          // A network/transport error -> stable class (no key/prose in the error).
   127	          throw new EmailTransportError("email_network_error", "Resend send network error");
   128	        }
   129	
   130	        // Trap part 1: a non-2xx HTTP status is a hard failure (fail-closed). Resend signals
   131	        // failure honestly via status, so this -- unlike Slack -- IS the primary failure path.
   132	        if (!response.ok) {
   133	          let body: { name?: string } = {};
   134	          try {
   135	            body = (await response.json()) as { name?: string };
   136	          } catch {
   137	            // Body unreadable/not JSON -- fall through with the status-coded class below.
   138	          }
   139	          if (controller.signal.aborted) {
   140	            throw new EmailTransportError("email_timeout", "Resend send body read timed out");
   141	          }
   142	          throw new EmailTransportError(
   143	            safeErrorCode(body.name, response.status),
   144	            `Resend send returned HTTP ${response.status}`
   145	          );
