     2	import { runExceptionPipeline } from "@/lib/pipeline/run-exception";
     3	import { hasActionOpsScenario } from "@/lib/data/actionops-scenarios";
     4	import { apiError, noStoreJson, parseJsonRequest, rateLimited } from "@/lib/server/http";
     5	import { IDEMPOTENCY_KEY_HEADER, verifyApprovalToken } from "@/lib/server/security";
     6	import { enforceMutationRateLimit } from "@/lib/server/rate-limit";
     7	import { logger } from "@/lib/server/logger";
     8	
     9	const RunRequestSchema = z.object({
    10	  // No default here: an omitted scenarioId must flow to getActionOpsScenario's
    11	  // DEFAULT_SCENARIO_ID (the single source of default truth). Hard-coding the
    12	  // retired "SCN-LAUNCH-001" default would route every bare run at an unknown
    13	  // scenario -> a 500. Present values are still validated as a string.
    14	  scenarioId: z.string().optional(),
    15	  // Default FALSE (2026-07-16 re-review, B-05): a zero-config call must not reach out to
    16	  // live GDELT/NWS — the keyless posture is "no live call unless explicitly asked", and a
    17	  // forgotten flag falls back to the recorded replay signals, never to the network.
    18	  useLiveSignals: z.boolean().default(false),
    19	  // Live-AI opt-in. Default FALSE: billing the Gemini budget requires an EXPLICIT
    20	  // per-request opt-in even behind the approval token (do not mirror useLiveSignals's
    21	  // default-true -- a forgotten flag must fall back to the free deterministic run, not
    22	  // silently bill). Effective only when the runtime also has the flag + key
    23	  // (liveAiEnabled()); otherwise the pipeline runs deterministically regardless.
    24	  live: z.boolean().default(false),
    25	  idempotencyKey: z
    26	    .string()
    27	    .trim()
    28	    .min(8)
    29	    .max(120)
    30	    .regex(/^[A-Za-z0-9_.:-]+$/)
    31	    .optional()
    32	});
    33	
    34	export async function POST(request: Request) {
    35	  // P2.7 (R4-4) corollary: a live-AI run must never be authless (strangers must
    36	  // not burn the $5 Gemini budget). This route was previously UNGATED; in secure
    37	  // mode (live AI / DATABASE_URL / opt-in) it now requires the bearer token.
    38	  const auth = verifyApprovalToken(request);
    39	  if (!auth.ok) {
    40	    return apiError(auth.code, auth.message, auth.status);
    41	  }
    42	
    43	  // Rate limit after auth, before pipeline work. This route can spend the live-AI
    44	  // budget, so the brake also caps how fast a single caller can drive billed runs.
    45	  // Single-instance brake; distributed limiting is the prod path (see rate-limit.ts).
    46	  const rate = enforceMutationRateLimit("run-exception", request);
    47	  if (!rate.allowed) {
    48	    return rateLimited(rate.retryAfterSeconds);
    49	  }
    50	
    51	  const parsed = await parseJsonRequest(request, RunRequestSchema);
    52	  if (!parsed.ok) {
    53	    return parsed.response;
    54	  }
    55	
    56	  // An unknown scenario id is a client error (400), not a pipeline failure (500):
    57	  // getActionOpsScenario throws on an unknown id, so validate at the boundary and
    58	  // return a precise 400 rather than letting it surface as PIPELINE_FAILED. An
    59	  // omitted scenarioId flows to the pipeline's DEFAULT_SCENARIO_ID.
    60	  if (parsed.data.scenarioId && !hasActionOpsScenario(parsed.data.scenarioId)) {
    61	    return apiError(
    62	      "INVALID_SCENARIO_ID",
    63	      `Unknown scenario ${parsed.data.scenarioId}`,
    64	      400
    65	    );
    66	  }
    67	
    68	  // `|| undefined` (2026-07-16 re-review, B-07): a present-but-blank header trims to ""
    69	  // — which is falsy for the validation guard below but NOT nullish, so it would win the
    70	  // `??` fallback and silently suppress a valid body idempotency key.
    71	  const headerIdempotencyKey = request.headers.get(IDEMPOTENCY_KEY_HEADER)?.trim() || undefined;
    72	  if (
    73	    headerIdempotencyKey &&
    74	    !/^[A-Za-z0-9_.:-]{8,120}$/.test(headerIdempotencyKey)
    75	  ) {
    76	    return apiError(
    77	      "INVALID_IDEMPOTENCY_KEY",
    78	      "Idempotency key must be 8-120 URL-safe characters",
    79	      400
    80	    );
    81	  }
    82	
    83	  try {
    84	    const packet = await runExceptionPipeline({
    85	      scenarioId: parsed.data.scenarioId,
    86	      useLiveSignals: parsed.data.useLiveSignals,
    87	      live: parsed.data.live,
    88	      idempotencyKey: headerIdempotencyKey ?? parsed.data.idempotencyKey
    89	    });
    90	    return noStoreJson({ packet });
    91	  } catch (error) {
    92	    // Log the real cause server-side (pino redacts secret-shaped fields); never
    93	    // return raw error text to the client -- it can leak internal/pg detail.
    94	    logger.error({ err: error, route: "run-exception" }, "run-exception pipeline failed");
    95	    return noStoreJson(
    96	      {
    97	        error: "PIPELINE_FAILED",
    98	        detail: "The pipeline failed to complete."
    99	      },
   100	      { status: 500 }
   101	    );
   102	  }
   103	}

