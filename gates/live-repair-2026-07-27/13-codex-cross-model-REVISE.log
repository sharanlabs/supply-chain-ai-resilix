   186	// buildSkepticFinding: assemble the STRUCTURED finding from the validated upstream slices. The
   187	// ONLY place the Skeptic's view of the world is constructed -- so the quarantine guarantee lives in
   188	// ONE function. topSectors lists DISTINCT actionable (non-OTHER_UNMAPPED) sectors; singleSourceCount
   189	// counts exposures with no qualified backup (the concentration risk Atlas flags). No names, no
   190	// rationale, no summary.
   191	export function buildSkepticFinding(
   192	  threatCard: ThreatCard,
