   346	  // Defaults: 8k input envelope; output locked to the live cap (the estimate must never
   347	  // under-price what a call can emit). A caller whose real prompt grows across steps (the
   348	  // Investigator loop) passes its own input estimate — a fixed envelope is NOT an upper
   349	  // bound once accumulated context exceeds it (2026-07-16 re-review, A-07).
   350	  const inputTokens = envelope?.inputTokens ?? 8_000;
   351	  const outputTokens = envelope?.outputTokens ?? MAX_LIVE_OUTPUT_TOKENS;
   352	  return costUsd(model, inputTokens, outputTokens);
   353	}
