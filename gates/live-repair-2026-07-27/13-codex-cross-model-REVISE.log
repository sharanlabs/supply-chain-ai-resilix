   166	        // Success: id is Resend's message id -> the audit providerRef. delivered:true.
   167	        logger.info(
   168	          {
   169	            event: "action.email_dispatch",
   170	            actionType: message.actionType,
   171	            channel: message.channel,
   172	            idempotencyKey: message.idempotencyKey,
   173	            delivered: true
   174	          },
   175	          "email-transport: message delivered"
   176	        );
