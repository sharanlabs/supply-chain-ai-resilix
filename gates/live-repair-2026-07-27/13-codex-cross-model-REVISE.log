   152	    // "cannot confirm" as "contradicts" (the structural false-veto that bit the chokepoint flagship).
   153	    geo: GeoStatus;
   154	    freshestMinutes: number | null;
   155	  };
   156	  exposure: {
   157	    count: number;
   158	    topSectors: string[];
   159	    singleSourceCount: number;
   160	  };
   161	};
