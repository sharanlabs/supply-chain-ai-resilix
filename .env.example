# Optional. Without this, RESILIX runs in deterministic demo mode.
GEMINI_API_KEY=

# Set to true to call bounded structured-output agents instead of deterministic fallbacks.
ENABLE_LIVE_AI=false

# Optional. Defaults to gemini-2.5-flash when live AI is enabled.
GEMINI_MODEL=

# Cross-family LLM judge (ADR-0002). The no-unsupported-claims judge defaults to the Gemini
# same-family path; set JUDGE_PROVIDER=groq to route it to a non-Gemini model (no self-preference
# bias) via Groq's FREE tier. Default Groq model: meta-llama/llama-4-scout-17b-16e-instruct
# (override with JUDGE_MODEL). The judge stays secondary + fail-closed + off-by-default.
JUDGE_PROVIDER=
JUDGE_MODEL=

# Required only when JUDGE_PROVIDER=groq. Free-tier key from console.groq.com (no card needed).
GROQ_API_KEY=

# Optional Postgres/Neon target for persistent packet storage.
DATABASE_URL=

# Optional n8n webhook target for approval notifications.
N8N_APPROVAL_WEBHOOK_URL=

# Optional. When set, /api/n8n/approval-callback requires this value in
# x-resilix-callback-secret plus callbackEventId and callbackSentAt.
# P2.7: in secure mode (below) this secret is MANDATORY (no demo pass-through).
N8N_CALLBACK_SECRET=

# P2.7 (R4-4) fail-closed auth. Bearer token required on the mutation routes
# (supplier upload, packet approve, run-exception) whenever the app is in SECURE
# MODE -- i.e. DATABASE_URL is set, live AI is enabled, or REQUIRE_APPROVAL_TOKEN
# is true. A pure in-memory demo (none of those) stays authless + disclosed. If
# secure mode is ON but this is unset, mutations are DENIED (fail-closed, 503).
APPROVAL_TOKEN=

# Force fail-closed auth even in a pure in-memory deployment. MANDATORY for any
# SHARED or PUBLIC demo (no DATABASE_URL, no live AI): without it an exposed
# in-memory deployment is authless. Only a local single-user demo may leave it
# false. (Accepts true/1/yes/on, case- and whitespace-insensitive.)
REQUIRE_APPROVAL_TOKEN=false

# Phase 5 governed action execution. When TRUE, the /api/decision-packets/[id]/execute
# route may AUTO-FIRE the REVERSIBLE/internal actions (alert, log, ticket draft) of an
# APPROVED packet via the transactional outbox. IRREVERSIBLE/OUTWARD actions (supplier
# email, RFQ, n8n->ERP case) are NEVER auto-sent regardless of this flag -- they stay
# PENDING for an explicit human-approved execution. Default OFF. (Accepts
# true/1/yes/on.) NOTE: even when ON, the default transport is the Noop (logs, never
# sends) -- a real Slack/email/n8n transport is a separate operator/runtime wiring step.
ENABLE_REVERSIBLE_AUTO_EXECUTE=false

# Phase 5 transport adapter #1: SLACK (the ROLE_OWNER_ALERT channel -- a reversible,
# INTERNAL crisis alert; NOT the outbound supplier path). A real Slack transport is wired
# ONLY when BOTH of these are set (transportRegistryFromEnv); otherwise the SLACK channel
# stays on the Noop (logs, never sends). The bot needs the chat:write scope and must be a
# member of the target channel (or have chat:write.public). Create at api.slack.com/apps.
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=

# Phase 5 transport adapter #2: EMAIL via Resend (free 3k/mo, resend.com). EMAIL is
# classified for SUPPLIER_EMAIL_SEND/RFQ_DISPATCH (irreversible/outward -- NEVER
# auto-sent, always a human-gated execution), but those actions' digest is IDs-only
# (the real subject/body prose stays server-side). So this is MECHANICS-ONLY scope:
# it sends the sanitized digest as a notification to YOUR OWN inbox
# (RESEND_ALERT_EMAIL), not a real supplier recipient -- it proves the transport,
# not the full supplier-send. A real transport is wired ONLY when ALL THREE of these
# are set (transportRegistryFromEnv); otherwise the EMAIL channel stays on the Noop.
# RESEND_FROM_EMAIL must be a verified sender/domain in your Resend account.
# Create a key at resend.com/api-keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_ALERT_EMAIL=
