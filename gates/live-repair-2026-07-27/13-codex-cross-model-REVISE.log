   222	// ---- Calibration statistics (pure; unit-tested below, consumed by the gated live run) ----
   223	
   224	// Cohen's kappa over the 2x2 confusion of {human label} x {judge verdict}, positive class =
   225	// UNSUPPORTED (the claim we want flagged). Chance-corrected agreement -- a stronger statistic
   226	// than raw TPR/TNR, which a degenerate "flag everything" judge can game on the positive class.
   227	// kappa <= 0: no better than chance; 0.6-0.8 substantial; > 0.8 near-perfect (Landis-Koch).
   228	export function cohensKappa(c: { tp: number; fp: number; tn: number; fn: number }): number {
   229	  const n = c.tp + c.fp + c.tn + c.fn;
   230	  if (n === 0) return 0;
   231	  const po = (c.tp + c.tn) / n;
   232	  // Expected-by-chance: P(human=unsupported)*P(judge=flag) + P(human=supported)*P(judge=pass).
   233	  const pe =
   234	    ((c.tp + c.fn) / n) * ((c.tp + c.fp) / n) + ((c.fp + c.tn) / n) * ((c.fn + c.tn) / n);
   235	  // Perfect expected agreement (a single class present) -> kappa undefined; collapse to 1 iff
   236	  // observed is also perfect, else 0 (no chance-corrected signal is available).
   237	  if (1 - pe === 0) return po >= 1 ? 1 : 0;
   238	  return (po - pe) / (1 - pe);
   239	}
   240	
   241	// Classify one judge verdict against its human label into a confusion cell -- or "error"
   242	// (EV-09, 2026-07-16 re-review). A verdict that ERRORED (threw / unparseable / budget breach /
   243	// LIVE_AI disabled) fails closed to supported:false OPERATIONALLY -- the right safety default --
   244	// but it is NOT evidence the judge DISCRIMINATED anything. Counting an errored fail-closed as a
   245	// true positive would INFLATE TPR with the judge's own failures (the exact opposite of what the
   246	// prior comment claimed). So errors are their OWN bucket, excluded from tp/fp/tn/fn, and bounded
   247	// by a separate assertion so exclusion is not a loophole a high-error judge could hide behind.
   248	export type ConfusionCell = "tp" | "fp" | "tn" | "fn" | "error";
   249	export function classifyJudgeVerdict(
   250	  labelSupported: boolean,
   251	  verdict: { supported: boolean; errored: boolean }
   252	): ConfusionCell {
   253	  if (verdict.errored) return "error";
   254	  const flagged = verdict.supported === false;
   255	  if (!labelSupported) return flagged ? "tp" : "fn";
   256	  return flagged ? "fp" : "tn";
   257	}
