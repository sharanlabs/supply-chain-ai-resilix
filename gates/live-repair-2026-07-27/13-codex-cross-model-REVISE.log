    77	export function createSlackTransport(config: SlackTransportConfig): ActionTransport {
    78	  const doFetch = config.fetchImpl ?? fetch;
    79	  const timeoutMs = config.timeoutMs ?? DEFAULT_TIMEOUT_MS;
    80	  return {
    81	    name: "slack",
    82	    async deliver(message: TransportMessage): Promise<TransportReceipt> {
    83	      // Hard timeout spanning the ENTIRE call -- the fetch AND the body read. A server can
    84	      // return 200 headers then stall the body forever (Codex closure High), so the timer
    85	      // stays armed through response.json() and is cleared only in the outer finally. Any
    86	      // abort -> slack_timeout -> FAILED; deliver() never blocks dispatchAndFinalize.
    87	      const controller = new AbortController();
    88	      const timer = setTimeout(() => controller.abort(), timeoutMs);
    89	      try {
    90	        let response: Response;
    91	        try {
    92	          response = await doFetch(SLACK_POST_MESSAGE_URL, {
    93	            method: "POST",
    94	            headers: {
    95	              // The token is sent ONLY in the Authorization header -- never logged, never in an error.
    96	              Authorization: `Bearer ${config.botToken}`,
    97	              "Content-Type": "application/json; charset=utf-8"
    98	            },
    99	            body: JSON.stringify({ channel: config.channel, text: digestToText(message) }),
   100	            signal: controller.signal
   101	          });
   102	        } catch {
   103	          if (controller.signal.aborted) {
   104	            throw new SlackTransportError("slack_timeout", "Slack chat.postMessage timed out");
   105	          }
   106	          // A network/transport error -> stable class (no token/prose in the error).
   107	          throw new SlackTransportError("slack_network_error", "Slack chat.postMessage network error");
   108	        }
   109	
   110	        // Trap part 1: a non-2xx HTTP status is a hard failure (fail-closed).
   111	        if (!response.ok) {
   112	          throw new SlackTransportError(
   113	            `slack_http_${response.status}`,
   114	            `Slack chat.postMessage returned HTTP ${response.status}`
   115	          );
   116	        }
   117	
   118	        // Parse the body (still under the timeout). A parse failure is classified stably
   119	        // (Codex Med: no raw SyntaxError); an abort DURING the body read is a timeout
   120	        // (Codex closure High: a stalled body must still fail-closed).
   121	        let body: { ok?: boolean; error?: string; ts?: string };
   122	        try {
   123	          body = (await response.json()) as { ok?: boolean; error?: string; ts?: string };
   124	        } catch {
   125	          if (controller.signal.aborted) {
   126	            throw new SlackTransportError("slack_timeout", "Slack chat.postMessage body read timed out");
   127	          }
   128	          throw new SlackTransportError("slack_invalid_json", "Slack chat.postMessage returned unparseable JSON");
   129	        }
   130	
