   225	// A RUN-LEVEL retry reserve: a SHARED pool of extra live attempts the agents draw from when
   226	// an output fails its firewall/parse. tryConsume() decrements and returns true while attempts
   227	// remain, false when the pool is empty. One object is threaded to all three LLM agents, so the
   228	// total retries -- and thus the worst-case billed call count -- is bounded run-wide, never
   229	// per-agent (which would let three agents each retry and blow the call-count ceiling).
   230	export type RetryReserve = { tryConsume: () => boolean };
   231	
   232	export function makeRetryReserve(total: number = LIVE_RETRY_RESERVE): RetryReserve {
   233	  let remaining = Math.max(0, Math.floor(total));
   234	  return {
   235	    tryConsume: () => {
   236	      if (remaining > 0) {
   237	        remaining -= 1;
   238	        return true;
   239	      }
   240	      return false;
   241	    }
   242	  };
   243	}
