# Optional. Without this, RESILIX runs in deterministic demo mode.
GEMINI_API_KEY=

# Set to true to call bounded structured-output agents instead of deterministic fallbacks.
ENABLE_LIVE_AI=false

# Optional. Defaults to gemini-3-flash-preview when live AI is enabled.
GEMINI_MODEL=

# Cross-family LLM judge (ADR-0002). The no-unsupported-claims judge defaults to the Gemini
# same-family path; set JUDGE_PROVIDER=groq to route it to a non-Gemini model (no self-preference
# bias) via Groq's FREE tier. Default Groq model: meta-llama/llama-4-scout-17b-16e-instruct
# (override with JUDGE_MODEL). The judge stays secondary + fail-closed + off-by-default.
JUDGE_PROVIDER=
JUDGE_MODEL=

# Required only when JUDGE_PROVIDER=groq. Free-tier key from console.groq.com (no card needed).
GROQ_API_KEY=

# Optional Postgres/Neon target for persistent packet storage.
DATABASE_URL=

# Optional n8n webhook target for approval notifications.
N8N_APPROVAL_WEBHOOK_URL=

# Optional. When set, /api/n8n/approval-callback requires this value in
# x-resilix-callback-secret plus callbackEventId and callbackSentAt.
# P2.7: in secure mode (below) this secret is MANDATORY (no demo pass-through).
N8N_CALLBACK_SECRET=

# P2.7 (R4-4) fail-closed auth. Bearer token required on the mutation routes
# (supplier upload, packet approve, run-exception) whenever the app is in SECURE
# MODE -- i.e. DATABASE_URL is set, live AI is enabled, or REQUIRE_APPROVAL_TOKEN
# is true. A pure in-memory demo (none of those) stays authless + disclosed. If
# secure mode is ON but this is unset, mutations are DENIED (fail-closed, 503).
APPROVAL_TOKEN=

# Force fail-closed auth even in a pure in-memory deployment. MANDATORY for any
# SHARED or PUBLIC demo (no DATABASE_URL, no live AI): without it an exposed
# in-memory deployment is authless. Only a local single-user demo may leave it
# false. (Accepts true/1/yes/on, case- and whitespace-insensitive.)
REQUIRE_APPROVAL_TOKEN=false
