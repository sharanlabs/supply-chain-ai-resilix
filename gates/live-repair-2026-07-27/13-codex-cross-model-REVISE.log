   792	export type PacketExecutionSummary = {
   793	  packetId: string;
   794	  approvalStatus: ApprovalStatus;
   795	  autoExecuteReversible: boolean;
   796	  executed: number;
   797	  failed: number;
   798	  pending: number;
   799	  skipped: number;
   800	  // A row left DISPATCHING (claimed, not yet finalized). In the normal sweep this is 0 --
   801	  // each dispatch finalizes synchronously. It is >0 only when this sweep RE-RAN over a row
   802	  // a prior crashed run stranded (the duplicate hit returns the stranded DISPATCHING row);
   803	  // reconcileStrandedDispatches is what clears it. Counted so a stranded row never hides.
   804	  dispatching: number;
   805	  actions: ExecutedAction[];
   806	};
