   245	// The caller's validation of a raw live object: a clean parse + firewall pass yields the typed
   246	// value; a failure names the reason + class and whether it is worth a retry. A stochastic slip
   247	// (a numeral in a numeral-free field, a unit off the whitelist) IS retryable; a structural
   248	// problem is not. The errorClass flows straight into the agent's FAILED_TO_FALLBACK ledger.
   249	export type LiveValidateResult<T> =
   250	  | { ok: true; value: T }
   251	  | { ok: false; reason: string; errorClass: string; retryable: boolean };
   252	
   253	// liveGenerateValidated: liveGenerateObject + the caller's validate(), with a BOUNDED retry on
   254	// a RETRYABLE validation failure, drawn from a SHARED run-level reserve. Why: a live agent
   255	// occasionally emits a stochastic slip the firewall rightly rejects; a single re-ask usually
   256	// clears it, keeping the run all-LIVE instead of degrading to FAILED_TO_FALLBACK. Bounded:
   257	// each retry consumes from the shared reserve (so the three agents cannot each retry and blow
   258	// the "3 (+2 reserve)" call ceiling), and the cumulative spend rises by the per-call estimate
   259	// each attempt so the budget hard-stop still fires across retries. A THROW (a budget breach or
   260	// a failed call) is NOT retried -- it propagates to the caller's catch, which classifies
   261	// BUDGET_EXCEEDED vs LIVE_CALL_THREW exactly as before. Returns the AGGREGATE usage across all
   262	// attempts (the resolved one plus any billed-but-rejected retries), so AgentRun.costUsd and the
   263	// packet's totalCostUsd are the EXACT gross spend, not a lower bound. (A budget breach or thrown
   264	// call is the one path that does not bill -- the caller's catch-path fallback records it 0-token.)
   265	export async function liveGenerateValidated<T>(args: {
   266	  model: string;
   267	  schema: z.ZodTypeAny;
   268	  prompt: string;
   269	  budget: BudgetContext;
   270	  validate: (object: unknown) => LiveValidateResult<T>;
   271	  retry?: RetryReserve;
   272	  generate?: (a: {
   273	    model: string;
   274	    schema: z.ZodTypeAny;
   275	    prompt: string;
   276	  }) => Promise<{ object: unknown; usage?: AgentRunUsage }>;
   277	}): Promise<
   278	  | { ok: true; value: T; usage: AgentRunUsage }
   279	  | { ok: false; reason: string; errorClass: string; usage: AgentRunUsage }
   280	> {
   281	  const { model, schema, prompt, budget, validate, retry, generate } = args;
   282	  const perCallEstimate = estimateLiveCallCostUsd(model);
   283	
   284	  // Aggregate the provider-reported usage across EVERY attempt (the resolved one PLUS any
   285	  // billed-but-rejected retries) so the returned usage -> AgentRun.costUsd is the EXACT gross
   286	  // spend, not just the final attempt. This closes the retry ledger undercount: a packet's
   287	  // totalCostUsd and the orchestrator's running spend then reflect what every attempt billed.
   288	  // (The caller's catch-path fallback -- a budget breach or thrown call -- stays 0-token: a
   289	  // breach is blocked BEFORE it bills, so nothing was spent on the call that threw.)
   290	  let agg: AgentRunUsage = { inputTokens: 0, outputTokens: 0, totalTokens: 0, finishReason: null };
   291	  const fold = (u: AgentRunUsage) => {
   292	    agg = {
   293	      inputTokens: (agg.inputTokens ?? 0) + (u.inputTokens ?? 0),
   294	      outputTokens: (agg.outputTokens ?? 0) + (u.outputTokens ?? 0),
   295	      totalTokens: (agg.totalTokens ?? 0) + (u.totalTokens ?? 0),
   296	      // The latest attempt's finish reason is the operative one for the emitted run.
   297	      finishReason: u.finishReason ?? agg.finishReason ?? null
   298	    };
   299	  };
   300	
   301	  // Cumulative spend across THIS agent's attempts so attempt N's hard-stop accounts for the
   302	  // earlier (billed) attempts -- a retry can never silently overshoot the cap.
   303	  let retrySpent = 0;
   304	  // Defensive per-agent attempt ceiling (1 base + the reserve) even if a mis-wired reserve
   305	  // never reports empty. The real bound in normal operation is retry.tryConsume() going false.
   306	  for (let attempt = 0; attempt <= LIVE_RETRY_RESERVE; attempt++) {
   307	    const { object, usage } = await liveGenerateObject({
   308	      model,
   309	      schema,
   310	      prompt,
   311	      budget: { ...budget, spentUsd: budget.spentUsd + retrySpent },
   312	      generate
   313	    });
